{
  "schemaVersion": 1,
  "pluginId": "local-rhythm-report",
  "version": "1.0.0",
  "hostRange": "3",
  "platform": [
    "win32",
    "darwin",
    "linux"
  ],
  "title": "镜头节奏检查",
  "source": "CUTDIRECTOR example extension",
  "license": "Project example",
  "capabilities": [
    "text-advice",
    "reference-analysis"
  ],
  "entryType": "dsh-service",
  "permissions": [
    "project-read"
  ],
  "cost": "free",
  "resume": "manual",
  "cancel": true,
  "readiness": "probe-required",
  "inputSchema": {
    "type": "object",
    "required": [
      "request",
      "projectId",
      "storyVersion"
    ],
    "properties": {
      "request": {
        "type": "string",
        "maxLength": 4000
      },
      "projectId": {
        "type": "string"
      },
      "storyVersion": {
        "type": "integer"
      },
      "story": {
        "type": "object",
        "additionalProperties": true
      },
      "assets": {
        "type": "array",
        "maxItems": 500,
        "items": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "text"
    ],
    "properties": {
      "text": {
        "type": "string",
        "maxLength": 12000
      }
    },
    "additionalProperties": false
  }
}